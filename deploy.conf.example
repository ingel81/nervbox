# Nervbox Deployment Konfiguration
# Kopieren nach deploy.conf und anpassen

# Raspberry Pi Verbindung
PI_HOST="192.168.0.188"
PI_USER="user"
# SSH-Key fuer Deployment (Public Key muss in ~/.ssh/authorized_keys auf dem Pi stehen)
PI_SSH_KEY="$HOME/.ssh/claude_agent"
# Passwort nur fuer manuellen Login, wird von deploy.ps1 nicht genutzt
# PI_PASS="PASSWORT_HIER"

# Pfade auf dem Pi
PI_APP_PATH="/opt/nervbox"
PI_DATA_PATH="/opt/nervbox-data"
PI_LOG_PATH="/var/log/nervbox"

# Lokale Pfade (relativ zum Script)
LOCAL_RELEASE_PATH="Release"
LOCAL_SOUNDS_PATH="../sounds"

# Anwendungs-Port
APP_PORT=80
