# Nervbox Docker Environment Variables
# Copy this file to .env and fill in your values

# Cloudflare Tunnel Token
# Get this from: Cloudflare Dashboard > Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Optional: Override JWT Secret (recommended for production)
# Must be at least 32 characters
# NERVBOX_SECRET=your_super_secret_jwt_key_here_32chars_min
